# Copy this file to .env and change the secret before deploying anywhere public.
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Only needed in production, when using a Render persistent disk. Point this
# at a file INSIDE the disk's mount path — and mount the disk somewhere that
# does NOT collide with this project's own folders (db/, public/, etc), or
# Render will silently hide your actual code there. Recommended: mount the
# disk at /var/data, then set this to /var/data/roms.sqlite. Leave blank for
# local development — it defaults to a file right here in db/.
DATABASE_PATH=

# Set this to require an invite code on new business signups (recommended while
# you're hand-picking pilot clients). Leave it blank/unset to allow open signup.
PILOT_INVITE_CODE=SANOBA2026

# Optional: paste a Discord or Slack "incoming webhook" URL here to get an
# instant notification whenever a new business signs up. Leave blank to skip.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Slack: api.slack.com/messaging/webhooks -> create an Incoming Webhook -> Copy URL
NOTIFY_WEBHOOK_URL=

# A private key only you and Adaiah know, used to view /api/admin/businesses
# (a list of every signup + how much each business is actually using the app).
# Make this a long random string, same way as JWT_SECRET.
ADMIN_KEY=change-this-to-a-long-random-string

# Optional: powers the "AI Daily Brief" button on the dashboard — a real
# Claude-generated paragraph of advice based on that business's actual data.
# Get a key at console.anthropic.com (pay-as-you-go, a few cents per brief).
# Leave blank to leave that feature off — everything else works without it.
ANTHROPIC_API_KEY=

# Powers the "Pay via MoMo / Card" button — real Paystack checkout. Sign up
# free at paystack.com (Ghana supports the no-registration-needed "Starter
# Business" tier — personal bank account is fine to start). Use your TEST
# secret key while building, LIVE key only once you're ready for real money.
PAYSTACK_SECRET_KEY=
# Your real deployed URL (e.g. https://roms-ghana-backend.onrender.com) — used
# to send customers back to the right place after paying. Leave blank while
# testing locally.
APP_URL=

# Optional: enables real email verification codes on signup. Leave any of
# these blank and verification is simply never required — no lockouts from
# an unconfigured mail server. Any standard SMTP provider works (Gmail app
# password, Resend, Mailgun, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
